@component-name = "portal-analytics-cloud"
definition {

	property portal.release = "false";
	property portal.upstream = "true";
	property property.group = "analytics.cloud.profile";
	property testray.main.component.name = "Analytics Cloud";

	setUp {
		Navigator.openURL(baseURL = "https://osbasahdxpserver73-ac-stagingdxps.lfr.cloud/");
	}

	tearDown {
		ACUtils.closeAllSessionsAndWait();
	}

	@description = "Test Summary: Perform clicks for AB testing as Abby AB"
	@priority = "5"
	test GenerateABTestData {
		ACUtils.navigateToSitePageWithUser(
			emailList = "abby.ab@liferay.com",
			pageName = "Home",
			siteName = "Brother Ocean Co.");

		Navigator.gotoSitePage(pageName = "Shop");

		ACPersonas.buyBoard();
	}

	@description = "Test Summary: Search for key words and article as Steven Searcher"
	@priority = "5"
	test GenerateSearchData {
		ACUtils.navigateToSitePageWithUser(
			emailList = "steven.searcher@liferay.com",
			pageName = "Home",
			siteName = "Brother Ocean Co.");

		ACUtils.searchBar(searchItem = "surf");

		Click(locator1 = "ACPersonas#SEARCH_RESULT");

		ACUtils.searchBar(searchItem = "beach");

		Click(locator1 = "ACPersonas#SEARCH_RESULT");
	}

	@description = "Test Summary: Shop for different items as Sally Shopper"
	@priority = "5"
	test GenerateShopData {
		ACUtils.navigateToSitePageWithUser(
			emailList = "sally.shopper@liferay.com",
			pageName = "Home",
			siteName = "Brother Ocean Co.");

		Navigator.gotoSitePage(pageName = "Shop");

		ACPersonas.buyBoard();

		ACPersonas.buySwimwear();

		ACPersonas.buyGear();

	}

    @description = "Test Summary: Cindy wants to create a custom event"
    @priority = "4"
	test GenerateRandomEvents {
        ACUtils.navigateToSitePageWithUser(
			emailList = "cindy.customevent@liferay.com",
			pageName = "Home",
			siteName = "Brother Ocean Co.");

		Navigator.gotoPage(pageName = "Tools");

		ACPersonas.addRandomEvent(randomEventName = "Cindy's Event",
                                  attributeCount = "5");

        Click(locator1 = "ACPersonas#BOOLEAN_CHECK_BOX");

        Click(locator1 = "ACPersonas#DURATION_CHECK_BOX");

		Click(locator1 = "ACPersonas#DATE_CHECK_BOX");

        Click(locator1 = "ACPersonas#GENERATE_RANDOM_EVENT_BUTTON");

        ACPersonas.addCustomEvent(placementAttributes = "height",
                                  attributeValues = "5");

    }

	@description = "Test Summary: Browse blog page as Barbara Blogger"
	@priority = "5"
	test GenerateBlogData {
		ACUtils.navigateToSitePageWithUser(
			emailList = "barbara.blogger@liferay.com",
			pageName = "Home",
			siteName = "Brother Ocean Co.");

		Navigator.gotoSitePage(pageName = "Blog");

	}

}
</thead>
<tbody>
<!-- ASSETS  -->
<tr>
	<td>ASSETS_PAGINATION</td>
	<td>//*[contains(@class,'pagination-root')]//*[contains(@class,'page-item')]//*[contains(text(),'${key_page}')]</td>
